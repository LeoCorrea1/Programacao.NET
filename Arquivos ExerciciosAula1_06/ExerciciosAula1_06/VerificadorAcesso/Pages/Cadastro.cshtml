@page
@model WebApp.Pages.CadastroModel
@{
    ViewData["Title"] = "Verificador de Acesso";
}

<h1>Verificador de Acesso</h1>

<form method="post">
    <div>
        <label>Nome:</label>
        <input asp-for="Nome" />
    </div>
    <div>
        <label>Idade:</label>
        <input asp-for="Idade" type="number" />
    </div>

    <button type="submit">Verificar</button>
</form>

@if (!string.IsNullOrEmpty(Model.MensagemDeRetorno))
{
    <p>@Model.MensagemDeRetorno</p>
}