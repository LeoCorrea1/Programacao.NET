@page
@model WebApp.Pages.CalculadoraModel
@{
    ViewData["Title"] = "Calculadora de Divisão Segura";
}

<h1>Calculadora de Divisão Segura</h1>

<form method="post">
    <div>
        <label>Primeiro Número:</label>
        <input asp-for="Numero1" type="number" />
    </div>
    <div>
        <label>Segundo Número:</label>
        <input asp-for="Numero2" type="number" />
    </div>

    <button type="submit">Dividir</button>
</form>

@if (Model.Resultado != null)
{
    <div style="background-color: lightblue; padding: 10px; margin-top: 10px;">
        Resultado: @Model.Resultado
    </div>
}

@if (!string.IsNullOrEmpty(Model.MensagemDeErro))
{
    <div style="background-color: lightcoral; padding: 10px; margin-top: 10px;">
        @Model.MensagemDeErro
    </div>
}